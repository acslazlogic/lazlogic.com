---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <g fill="var(--accent)">
      <circle cx="7" cy="5" r="2.2"></circle>
      <circle cx="7" cy="12" r="2.2"></circle>
      <circle cx="7" cy="19" r="2.2"></circle>
    </g>
    <g fill="currentColor">
      <circle cx="7" cy="26.5" r="2.2"></circle>
      <circle cx="14.5" cy="26.5" r="2.2"></circle>
      <circle cx="22" cy="26.5" r="2.2"></circle>
    </g>
    <g fill="var(--accent)">
      <circle cx="15" cy="15" r="1.5" opacity=".55"></circle>
      <circle cx="22.5" cy="8.5" r="1.5" opacity=".55"></circle>
      <circle cx="25" cy="18" r="1.5" opacity=".35"></circle>
      <circle cx="29" cy="3" r="1.2" opacity=".25"></circle>
    </g>
  </svg>
  <span class="logo__word">LazLogic</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }
  .logo__word {
    font-size: 20px;
    font-weight: 620;
    letter-spacing: -0.04em;
  }
</style>
