---
const industries = [
  {
    id: 'survey',
    scene: 'corridor',
    label: 'Survey & Engineering',
    title: 'Drafting-ready features from every corridor scan',
    body: 'Extract breaklines, kerbs, lane markings, signs and poles straight from mobile and terrestrial lidar, then QA them in the same browser tab.',
    points: ['Breaklines & ground surfaces', 'Kerb, edge & lane linework', 'Signs, poles & street furniture', 'DXF, DGN & LandXML export'],
  },
  {
    id: 'utilities',
    scene: 'powerline',
    label: 'Electric Utilities',
    title: 'Find every clearance risk before the storm does',
    body: 'Classify conductors, structures and vegetation across the whole network, test clearances against your rules, and push work orders to the field.',
    points: ['Conductor & structure extraction', 'Vegetation encroachment', 'Sag & clearance modelling', 'Sync to your GIS asset register'],
  },
  {
    id: 'mining',
    scene: 'mine',
    label: 'Mining & Resources',
    title: 'Volumes, benches and stockpiles, every survey',
    body: 'Turn drone and terrestrial scans into stockpile volumes, crest and toe lines, and highwall change detection without waiting on the survey backlog.',
    points: ['Stockpile volumes & reconciliation', 'Crest & toe extraction', 'Epoch-to-epoch change detection', 'Haul road & berm compliance'],
  },
  {
    id: 'construction',
    scene: 'site',
    label: 'Construction & AEC',
    title: 'Progress you can measure, not just photograph',
    body: 'Compare as-built scans with design models, track progress floor by floor, and catch deviations while they are still cheap to fix.',
    points: ['Scan-to-BIM comparison', 'Progress & earthworks tracking', 'Deviation heatmaps', 'IFC & BCF round-tripping'],
  },
  {
    id: 'government',
    scene: 'city',
    label: 'Government & Cities',
    title: 'A living digital twin of the whole city',
    body: 'Inventory every pole, tree, sign and building across the municipality, refresh it with each capture cycle, and share it with every department.',
    points: ['Asset inventories', 'Tree canopy & urban heat', 'Building footprints & heights', '3D Tiles & OGC API publishing'],
  },
];
---

<section class="section industries" id="solutions">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <span class="eyebrow reveal">Solutions</span>
        <h2 class="reveal" style="margin-top:22px">Built for the teams who measure the world</h2>
      </div>
      <p class="lede reveal">
        The same platform, tuned for the assets you manage. Drag the divider to compare a raw scan with what
        LazLogic extracts from it.
      </p>
    </div>

    <div class="ind reveal" data-industries>
      <div class="ind__tabs" role="tablist" aria-label="Industries">
        {
          industries.map((ind, i) => (
            <button
              class="ind__tab"
              role="tab"
              id={`tab-${ind.id}`}
              aria-controls={`panel-${ind.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-scene={ind.scene}
            >
              {ind.label}
            </button>
          ))
        }
      </div>

      <div class="ind__body">
        <div class="ind__viewer">
          <canvas aria-label="Point cloud comparison: raw scan on the left, classified features on the right"></canvas>
          <span class="mono ind__tag ind__tag--l">Raw scan</span>
          <span class="mono ind__tag ind__tag--r">LazLogic</span>
          <div
            class="ind__handle"
            role="slider"
            tabindex="0"
            aria-label="Comparison divider"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
            data-handle
          >
            <span class="ind__knob" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M6 4 1 9l5 5M12 4l5 5-5 5" stroke="currentColor" stroke-width="1.5"></path></svg>
            </span>
          </div>
          <ul class="ind__legend" data-legend></ul>
          <p class="ind__fallback">Interactive 3D preview needs WebGL.</p>
        </div>

        {
          industries.map((ind, i) => (
            <div class="ind__panel" role="tabpanel" id={`panel-${ind.id}`} aria-labelledby={`tab-${ind.id}`} hidden={i !== 0}>
              <h3>{ind.title}</h3>
              <p>{ind.body}</p>
              <ul>
                {ind.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ind {
    display: grid;
    gap: 28px;
  }
  .ind__tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .ind__tabs::-webkit-scrollbar {
    display: none;
  }
  .ind__tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: none;
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    font-size: 15px;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .ind__tab:hover {
    color: var(--text);
    border-color: var(--hairline-strong);
  }
  .ind__tab[aria-selected='true'] {
    color: var(--text);
    background: var(--chip);
    border-color: var(--hairline-strong);
  }

  .ind__body {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
  }
  .ind__viewer {
    position: relative;
    min-height: 520px;
    border-right: 1px solid var(--hairline);
    background: var(--bg);
  }
  .ind__viewer canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }
  .ind__tag {
    position: absolute;
    top: 18px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgb(11 12 12 / 0.75);
    border: 1px solid var(--hairline);
    font-size: 10.5px;
    pointer-events: none;
  }
  .ind__tag--l {
    left: 18px;
    color: var(--text-2);
  }
  .ind__tag--r {
    right: 18px;
    color: var(--accent);
  }
  .ind__handle {
    --split: 50%;
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 44px;
    margin-left: -22px;
    cursor: ew-resize;
    touch-action: none;
    display: grid;
    place-items: center;
  }
  .ind__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(transparent, var(--accent) 15%, var(--accent) 85%, transparent);
    box-shadow: 0 0 12px var(--accent);
  }
  .ind__knob {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 0 0 6px rgb(61 245 196 / 0.15);
  }
  .ind__legend {
    position: absolute;
    left: 18px;
    bottom: 18px;
    max-width: calc(100% - 36px);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 10px 14px;
    list-style: none;
    background: rgb(11 12 12 / 0.75);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }
  .ind__legend :global(li) {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-2);
  }
  .ind__legend :global(i) {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .ind__fallback {
    display: none;
    position: absolute;
    inset: 0;
    place-items: center;
    color: var(--text-3);
  }
  .ind__viewer:global(.no-webgl) .ind__fallback {
    display: grid;
  }
  .ind__viewer:global(.no-webgl) .ind__handle {
    display: none;
  }

  .ind__panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(28px, 3vw, 44px);
  }
  .ind__panel[hidden] {
    display: none;
  }
  .ind__panel h3 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .ind__panel p {
    color: var(--text-2);
  }
  .ind__panel ul {
    margin: auto 0 0;
    padding: 18px 0 0;
    list-style: none;
    display: grid;
    border-top: 1px solid var(--hairline);
  }
  .ind__panel li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 15px;
  }
  .ind__panel li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--accent);
    transform: rotate(45deg);
    flex: none;
  }

  @media (max-width: 960px) {
    .ind__body {
      grid-template-columns: 1fr;
    }
    .ind__viewer {
      min-height: 0;
      aspect-ratio: 4 / 3.2;
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }
  }
</style>

<script>
  import { SCENES, CLASS_COLORS, type Scene, type SceneName } from '../scripts/scenes';
  import { PointCloudView } from '../scripts/pointcloud';

  const root = document.querySelector<HTMLElement>('[data-industries]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const viewer = root.querySelector<HTMLElement>('.ind__viewer')!;
  const canvas = viewer.querySelector('canvas')!;
  const handle = root.querySelector<HTMLElement>('[data-handle]')!;
  const legend = root.querySelector<HTMLElement>('[data-legend]')!;
  const density = window.matchMedia('(max-width: 720px)').matches ? 0.5 : 0.85;

  const cache = new Map<SceneName, Scene>();
  const sceneFor = (name: SceneName) => {
    if (!cache.has(name)) cache.set(name, SCENES[name](name === 'city' ? 42 : undefined, density));
    return cache.get(name)!;
  };

  let view: PointCloudView | null = null;
  let started = false;

  const show = (name: SceneName) => {
    const scene = sceneFor(name);
    legend.innerHTML = scene.legend
      .map((l) => `<li><i style="background:${CLASS_COLORS[l.cls]}"></i>${l.name}</li>`)
      .join('');
    view?.setScene(scene);
  };

  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    if (focus) tab.focus();
    tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    show(tab.dataset.scene as SceneName);
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) {
        e.preventDefault();
        select(tabs[(i + d + tabs.length) % tabs.length], true);
      }
    });
  });

  // Comparison divider.
  const setSplit = (v: number) => {
    const s = Math.min(0.97, Math.max(0.03, v));
    handle.style.setProperty('--split', `${s * 100}%`);
    handle.setAttribute('aria-valuenow', String(Math.round(s * 100)));
    if (view) {
      view.split = s;
      view.draw();
    }
  };
  let dragging = false;
  const fromEvent = (e: PointerEvent) => {
    const r = viewer.getBoundingClientRect();
    setSplit((e.clientX - r.left) / r.width);
  };
  handle.addEventListener('pointerdown', (e) => {
    dragging = true;
    handle.setPointerCapture(e.pointerId);
    fromEvent(e);
  });
  handle.addEventListener('pointermove', (e) => dragging && fromEvent(e));
  handle.addEventListener('pointerup', () => (dragging = false));
  handle.addEventListener('pointercancel', () => (dragging = false));
  handle.addEventListener('keydown', (e) => {
    const cur = Number(handle.getAttribute('aria-valuenow')) / 100;
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      e.preventDefault();
      setSplit(cur + (e.key === 'ArrowRight' ? 0.05 : -0.05));
    }
  });

  // Defer scene generation until the section is close to the viewport.
  const io = new IntersectionObserver(
    ([e]) => {
      if (!e.isIntersecting || started) return;
      started = true;
      io.disconnect();
      try {
        view = new PointCloudView(canvas, { mode: 'compare', pointSize: 0.42 });
        view.lineAlpha = 0.8;
      } catch {
        viewer.classList.add('no-webgl');
      }
      setSplit(0.5);
      show(tabs[0].dataset.scene as SceneName);
    },
    { rootMargin: '400px 0px' },
  );
  io.observe(root);
</script>
