---
// Plan-view illustration for the shared-insight mock: a road corridor, its poles, tree canopy,
// and the poles flagged for vegetation clearance. Generated at build time from a fixed seed.
let seed = 29;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

const W = 520;
const H = 230;
const roadY = (x: number) => 118 + 34 * Math.sin(x / 120 + 0.4);
const roadPath = Array.from({ length: 27 }, (_, i) => {
  const x = i * 20;
  return `${i ? 'L' : 'M'}${x},${roadY(x).toFixed(1)}`;
}).join(' ');

const poles: { x: number; y: number; flagged: boolean }[] = [];
for (let x = 22; x < W - 10; x += 34) {
  poles.push({ x, y: roadY(x) - 20, flagged: false });
}
const flaggedIdx = [2, 3, 7, 10, 11, 13];
flaggedIdx.forEach((i) => poles[i] && (poles[i].flagged = true));

const trees: { x: number; y: number; r: number }[] = [];
for (let k = 0; k < 70; k++) {
  const x = rand() * W;
  const side = rand() < 0.62 ? -1 : 1;
  const y = roadY(x) + side * (30 + rand() * 70);
  if (y < 8 || y > H - 8) continue;
  trees.push({ x, y, r: 5 + rand() * 9 });
}
// Canopy that has crept toward the flagged poles.
for (const i of flaggedIdx) {
  const p = poles[i];
  if (p) trees.push({ x: p.x + (rand() - 0.5) * 10, y: p.y - 9 - rand() * 6, r: 8 + rand() * 4 });
}

const pillars = [
  {
    icon: '<path d="M5 22 12 13l5 5 9-11"/><circle cx="26" cy="7" r="2" fill="currentColor"/>',
    title: 'Answers, not files',
    body: 'LazLogic turns a scan into findings: counts, clearances, volumes and change, each linked back to the points that prove it. Nobody downloads 40 GB to get a number.',
  },
  {
    icon: '<path d="M13 19a5 5 0 0 0 7 0l4-4a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M19 13a5 5 0 0 0-7 0l-4 4a5 5 0 0 0 7 7l1.5-1.5"/>',
    title: 'Share a link, not a dataset',
    body: 'Send anyone a live, permissioned view. It opens in the browser on a laptop, tablet or phone, with no licence, plugin or workstation.',
  },
  {
    icon: '<circle cx="11" cy="12" r="4"/><circle cx="21" cy="12" r="4"/><path d="M4 26c1-4 4-6 7-6s6 2 7 6M14 26c1-4 4-6 7-6s6 2 7 6"/>',
    title: 'One version of the truth',
    body: 'Field crews, engineers and executives see the same measured insight, with comments, history and the source scan attached.',
  },
];
---

<section class="section insights" id="insights">
  <div class="container insights__grid">
    <div class="insights__copy">
      <span class="eyebrow reveal">Insights</span>
      <h2 class="reveal">An answer is only useful once it's shared</h2>
      <p class="lede reveal">
        Capture is solved. The hard part is turning billions of points into findings the whole organisation can
        see, trust and act on. LazLogic makes every insight something you can send.
      </p>
      <ul class="pillars">
        {
          pillars.map((p, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 0.06}s`}>
              <span class="pillars__icon">
                <svg viewBox="0 0 32 32" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
              </span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mock reveal" style="--reveal-delay:.1s" aria-label="Example of a shared LazLogic insight" role="img">
      <div class="mock__card">
        <div class="mock__head">
          <span class="mono mock__kind"><i></i>Insight · Vegetation clearance</span>
          <span class="mock__badge">Shared</span>
        </div>
        <p class="mock__title">6 poles have vegetation within 3 m of the conductors</p>

        <svg class="mock__plan" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
          <defs>
            <pattern id="plan-grid" width="26" height="26" patternUnits="userSpaceOnUse">
              <path d="M26 0H0V26" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"></path>
            </pattern>
          </defs>
          <rect width={W} height={H} fill="url(#plan-grid)"></rect>
          {trees.map((t) => <circle cx={t.x.toFixed(1)} cy={t.y.toFixed(1)} r={t.r.toFixed(1)} fill="#2fb35a" opacity="0.28" />)}
          <path d={roadPath} fill="none" stroke="#2a2f36" stroke-width="22" stroke-linecap="round"></path>
          <path d={roadPath} fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1" stroke-dasharray="7 7"></path>
          <path d={poles.map((p, i) => `${i ? 'L' : 'M'}${p.x},${p.y.toFixed(1)}`).join(' ')} fill="none" stroke="#ff5ea8" stroke-width="1" opacity="0.7"></path>
          {
            poles.map((p) =>
              p.flagged ? (
                <g>
                  <circle cx={p.x} cy={p.y.toFixed(1)} r="11" fill="rgba(255,59,59,0.12)" stroke="#ff3b3b" stroke-width="1.2" />
                  <rect x={p.x - 3} y={(p.y - 3).toFixed(1)} width="6" height="6" fill="#ff3b3b" />
                </g>
              ) : (
                <rect x={p.x - 2.5} y={(p.y - 2.5).toFixed(1)} width="5" height="5" fill="#3df5c4" />
              ),
            )
          }
        </svg>

        <div class="mock__metrics">
          <div><b>6</b><span>poles flagged</span></div>
          <div><b>1.8 m</b><span>min clearance</span></div>
          <div><b>14.2 km</b><span>corridor checked</span></div>
        </div>

        <div class="mock__share">
          <span class="mono mock__link">lazlogic.com/i/7kq2-veg-risk</span>
          <span class="mock__copy">Copy link</span>
        </div>
        <div class="mock__audience">
          <span class="mock__avatars" aria-hidden="true">
            <i style="background:#3df5c4">NO</i><i style="background:#f2a541">FC</i><i style="background:#8a96ff">AM</i>
          </span>
          <span>Shared with Network Ops, Field Crew and Asset Management</span>
        </div>
      </div>

      <div class="mock__comment">
        <span class="mono muted">Field Crew · 2h ago</span>
        <p>Trimming booked for Thursday. Starting with the two spans under 2 m.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .insights__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(48px, 7vw, 104px);
    align-items: center;
  }
  .insights__copy {
    display: grid;
    gap: 24px;
  }
  .insights__copy h2 {
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
  }
  .pillars {
    display: grid;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .pillars li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    padding: 22px 0;
    border-top: 1px solid var(--hairline);
  }
  .pillars__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--hairline-strong);
    border-radius: 10px;
    color: var(--accent);
  }
  .pillars h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }
  .pillars p {
    color: var(--text-2);
    font-size: 15.5px;
  }

  /* ---------- Shared insight mock ---------- */
  .mock {
    position: relative;
    padding-bottom: 84px;
  }
  .mock__card {
    position: relative;
    display: grid;
    gap: 18px;
    padding: 22px;
    border: 1px solid var(--hairline-strong);
    border-radius: 18px;
    background: var(--card);
    box-shadow: 0 40px 100px -50px rgb(61 245 196 / 0.3);
  }
  .mock__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .mock__kind {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-2);
    font-size: 11px;
  }
  .mock__kind i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff3b3b;
    box-shadow: 0 0 10px #ff3b3b;
  }
  .mock__badge {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-size: 12px;
    font-weight: 550;
  }
  .mock__title {
    font-size: 1.35rem;
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .mock__plan {
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: #090a0a;
  }
  .mock__metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--hairline);
  }
  .mock__metrics div {
    display: grid;
    gap: 2px;
    padding: 14px 0 14px 16px;
    border-left: 1px solid var(--hairline);
  }
  .mock__metrics div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .mock__metrics b {
    font-size: 1.4rem;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  .mock__metrics span {
    color: var(--text-3);
    font-size: 13px;
  }
  .mock__share {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 6px 6px 14px;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    background: var(--bg);
  }
  .mock__link {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-2);
    text-transform: none;
    letter-spacing: 0;
    font-size: 12.5px;
  }
  .mock__copy {
    flex: none;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 13px;
    font-weight: 600;
  }
  .mock__audience {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-3);
    font-size: 13.5px;
  }
  .mock__avatars {
    display: flex;
    flex: none;
  }
  .mock__avatars i {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: -7px;
    border: 2px solid var(--card);
    border-radius: 50%;
    color: #071310;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-style: normal;
    font-weight: 600;
  }
  .mock__avatars i:first-child {
    margin-left: 0;
  }
  .mock__comment {
    position: absolute;
    right: -18px;
    bottom: 0;
    width: min(320px, 80%);
    display: grid;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--hairline-strong);
    border-radius: 14px 14px 4px 14px;
    background: var(--bg-raised);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.8);
  }
  .mock__comment .mono {
    font-size: 10.5px;
  }
  .mock__comment p {
    font-size: 14.5px;
    color: var(--text);
  }

  @media (max-width: 1000px) {
    .insights__grid {
      grid-template-columns: 1fr;
    }
    .mock__comment {
      right: 12px;
    }
  }
  @media (max-width: 520px) {
    .mock__card {
      padding: 16px;
    }
    .mock__metrics b {
      font-size: 1.1rem;
    }
    .mock__metrics span {
      font-size: 12px;
    }
    .mock__audience span:last-child {
      font-size: 12.5px;
    }
  }
</style>
