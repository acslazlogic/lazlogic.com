---
const perks = [
  { title: 'Early access', body: 'Use new models and workflows months before general release, on your own data.' },
  { title: 'A direct line', body: 'Work with our engineers on a shared channel. Your edge cases shape the roadmap.' },
  { title: 'Founding pricing', body: 'Lock in design-partner pricing for the life of your contract.' },
];
---

<section class="section" id="partners">
  <div class="container">
    <div class="partners reveal">
      <div class="partners__glow" aria-hidden="true"></div>
      <div class="partners__copy">
        <span class="eyebrow">Design partner program</span>
        <h2>Help shape spatial intelligence from day one</h2>
        <p class="lede">
          We are working closely with a small group of survey, utility, mining and infrastructure teams. Bring a
          real dataset and a real problem; we will build the answer with you.
        </p>
        <a href="#demo" class="btn btn--primary">Apply to partner</a>
      </div>
      <ul class="partners__perks">
        {
          perks.map((p) => (
            <li>
              <svg class="partners__check" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="m3.5 9.5 3.5 3.5 7.5-8" stroke="currentColor" stroke-width="1.6" />
              </svg>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .partners {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    padding: clamp(32px, 5vw, 64px);
    border: 1px solid var(--hairline-strong);
    border-radius: 20px;
    background: var(--card);
    overflow: hidden;
  }
  .partners__glow {
    position: absolute;
    inset: -40% -10% auto auto;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(61 245 196 / 0.16), transparent 60%);
    pointer-events: none;
  }
  .partners__copy {
    position: relative;
    display: grid;
    gap: 24px;
    justify-items: start;
    align-content: start;
  }
  .partners__copy h2 {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
  }
  .partners__perks {
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    align-content: center;
  }
  .partners__perks li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 12px;
    padding: 22px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .partners__perks li:first-child {
    border-top: 1px solid var(--hairline);
  }
  .partners__check {
    margin-top: 3px;
    color: var(--accent);
  }
  .partners__perks h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }
  .partners__perks p {
    color: var(--text-2);
    font-size: 15.5px;
  }
  @media (max-width: 900px) {
    .partners {
      grid-template-columns: 1fr;
    }
  }
</style>
