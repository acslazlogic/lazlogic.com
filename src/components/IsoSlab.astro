---
// Isometric slab illustrations for the four workflow steps, generated at build time.
import { CLASS_COLORS } from '../scripts/scenes';

interface Props {
  variant: 'ingest' | 'understand' | 'query' | 'deliver';
}
const { variant } = Astro.props;

const C = Math.cos(Math.PI / 6);
const S = 0.5;
const box = [Infinity, Infinity, -Infinity, -Infinity];
const iso = (x: number, y: number, z: number): [number, number] => {
  const p: [number, number] = [(x - z) * C, (x + z) * S - y];
  box[0] = Math.min(box[0], p[0]);
  box[1] = Math.min(box[1], p[1]);
  box[2] = Math.max(box[2], p[0]);
  box[3] = Math.max(box[3], p[1]);
  return p;
};
const pts = (...p: [number, number][]) => p.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(' ');

let seed = { ingest: 3, understand: 7, query: 11, deliver: 19 }[variant];
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

type Shape = { kind: 'poly'; points: string; fill: string; stroke?: string; opacity?: number }
  | { kind: 'dot'; x: number; y: number; r: number; fill: string; opacity?: number }
  | { kind: 'line'; points: string; stroke: string; dash?: string; width?: number }
  | { kind: 'text'; x: number; y: number; text: string; fill: string };
const shapes: Shape[] = [];

const W = 120; // slab size in iso units
const slab = (y: number, t: number, top: string, side = '#121515', edge = 'rgba(255,255,255,0.14)', inset = 0) => {
  const a = inset;
  const b = W - inset;
  shapes.push({ kind: 'poly', points: pts(iso(a, y, b), iso(b, y, b), iso(b, y - t, b), iso(a, y - t, b)), fill: side, stroke: edge });
  shapes.push({ kind: 'poly', points: pts(iso(b, y, a), iso(b, y, b), iso(b, y - t, b), iso(b, y - t, a)), fill: '#0d0f0f', stroke: edge });
  shapes.push({ kind: 'poly', points: pts(iso(a, y, a), iso(b, y, a), iso(b, y, b), iso(a, y, b)), fill: top, stroke: edge });
};

// Terrain-ish heights so the dots read as a scan rather than a flat grid.
const h = (x: number, z: number) => 6 * Math.sin(x * 0.05) * Math.cos(z * 0.04) + 4;

const cloud = (y: number, n: number, color: (x: number, z: number) => string, opacity = 0.95) => {
  for (let i = 0; i < n; i++) {
    const x = 8 + rand() * (W - 16);
    const z = 8 + rand() * (W - 16);
    const [px, py] = iso(x, y + h(x, z), z);
    shapes.push({ kind: 'dot', x: px, y: py, r: 1.15, fill: color(x, z), opacity });
  }
};

const classOf = (x: number, z: number) => {
  if (Math.abs(z - 60) < 10) return CLASS_COLORS[1];
  if (x > 70 && z > 76) return CLASS_COLORS[5];
  if (x < 40 && z < 44) return CLASS_COLORS[4];
  if ((x * 7 + z * 3) % 37 < 2) return CLASS_COLORS[6];
  return CLASS_COLORS[0];
};
const gray = () => `rgb(${150 + rand() * 90 | 0},${160 + rand() * 90 | 0},${165 + rand() * 90 | 0})`;

if (variant === 'ingest') {
  slab(-30, 8, '#0f1212', '#0e1010', 'rgba(255,255,255,0.08)');
  slab(-14, 8, '#101313', '#0f1111', 'rgba(255,255,255,0.11)');
  slab(2, 8, '#121616');
  cloud(2, 260, gray, 0.8);
  // Points streaming in from above.
  for (let i = 0; i < 26; i++) {
    const x = 15 + rand() * 90;
    const z = 15 + rand() * 90;
    const y = 34 + rand() * 46;
    const [px, py] = iso(x, y, z);
    shapes.push({ kind: 'line', points: pts([px, py - 9], [px, py]), stroke: 'rgba(61,245,196,0.35)' });
    shapes.push({ kind: 'dot', x: px, y: py, r: 1.4, fill: '#3df5c4' });
  }
} else if (variant === 'understand') {
  slab(-14, 8, '#0f1212', '#0e1010', 'rgba(255,255,255,0.08)');
  slab(2, 8, '#121616');
  cloud(2, 340, classOf);
} else if (variant === 'query') {
  slab(2, 8, '#121616');
  cloud(2, 300, (x, z) => (x > 66 && x < 104 && z > 18 && z < 54 ? '#3df5c4' : 'rgba(170,180,182,0.55)'));
  // Selection volume.
  const [x0, x1, z0, z1, y0, y1] = [66, 104, 18, 54, 2, 34];
  const q = (x: number, y: number, z: number) => iso(x, y, z);
  shapes.push({ kind: 'poly', points: pts(q(x0, y1, z0), q(x1, y1, z0), q(x1, y1, z1), q(x0, y1, z1)), fill: 'rgba(61,245,196,0.08)', stroke: '#3df5c4' });
  for (const [x, z] of [[x0, z0], [x1, z0], [x1, z1], [x0, z1]]) {
    shapes.push({ kind: 'line', points: pts(q(x, y0, z), q(x, y1, z)), stroke: '#3df5c4', dash: '3 3' });
  }
  // Measurement.
  const m0 = q(16, 14, 100);
  const m1 = q(56, 14, 70);
  shapes.push({ kind: 'line', points: pts(m0, m1), stroke: '#f2a541', width: 1.4 });
  shapes.push({ kind: 'dot', x: m0[0], y: m0[1], r: 2.6, fill: '#f2a541' });
  shapes.push({ kind: 'dot', x: m1[0], y: m1[1], r: 2.6, fill: '#f2a541' });
  shapes.push({ kind: 'text', x: (m0[0] + m1[0]) / 2 - 22, y: (m0[1] + m1[1]) / 2 - 8, text: '42.18 m', fill: '#f2a541' });
} else {
  const layers: [number, string, string][] = [[-26, 'IFC', CLASS_COLORS[5]], [-8, 'GeoJSON', CLASS_COLORS[6]], [10, 'DXF', '#ffffff']];
  for (const [y, label, color] of layers) {
    slab(y, 3, '#111414', '#0f1111', 'rgba(255,255,255,0.12)', 6);
    // Vector linework on each layer.
    const lines: [number, number][][] = [
      [[16, 40], [50, 34], [90, 44], [112, 40]],
      [[16, 80], [52, 74], [86, 88], [112, 82]],
      [[30, 16], [34, 60], [28, 110]],
    ];
    for (const l of lines) shapes.push({ kind: 'line', points: pts(...l.map(([x, z]) => iso(x, y, z))), stroke: color, width: 1.1 });
    const [tx, ty] = iso(W - 6, y - 3, W - 6);
    shapes.push({ kind: 'text', x: tx + 8, y: ty + 2, text: label, fill: color });
  }
}

// Fit the drawing, leaving room on the right for layer labels; keep the frame wide enough for the slab.
const pad = 10;
const vb = [box[0] - pad, box[1] - pad, box[2] - box[0] + pad * 2 + (variant === 'deliver' ? 40 : 0), box[3] - box[1] + pad * 2]
  .map((v) => v.toFixed(1))
  .join(' ');
---

<svg class="iso" viewBox={vb} role="img" aria-label={`${variant} illustration`}>
  {
    shapes.map((s) =>
      s.kind === 'poly' ? (
        <polygon points={s.points} fill={s.fill} stroke={s.stroke ?? 'none'} stroke-width="0.8" stroke-linejoin="round" />
      ) : s.kind === 'dot' ? (
        <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r} fill={s.fill} opacity={s.opacity ?? 1} />
      ) : s.kind === 'line' ? (
        <polyline points={s.points} fill="none" stroke={s.stroke} stroke-width={s.width ?? 0.9} stroke-dasharray={s.dash} />
      ) : (
        <text x={s.x.toFixed(1)} y={s.y.toFixed(1)} fill={s.fill} font-family="var(--font-mono)" font-size="8.5" letter-spacing=".04em">
          {s.text}
        </text>
      ),
    )
  }
</svg>

<style>
  .iso {
    width: 100%;
    height: 210px;
    overflow: visible;
  }
</style>
