---
import IsoSlab from './IsoSlab.astro';

const steps = [
  {
    variant: 'ingest',
    name: 'Ingest',
    body: 'Drop in LAS, LAZ, E57 or COPC from any mobile, aerial or terrestrial sensor, alongside imagery and GIS layers. LazLogic indexes, reprojects and streams it. No tiling by hand.',
  },
  {
    variant: 'understand',
    name: 'Understand',
    body: 'AI classifies every point (ground, vegetation, buildings, poles, wires, road markings) and extracts clean, attributed vector features ready for review.',
  },
  {
    variant: 'query',
    name: 'Query',
    body: 'Ask spatial questions across the whole dataset: clearances, volumes, change over time, asset counts. Measure in the browser and share the answer as a link.',
  },
  {
    variant: 'deliver',
    name: 'Deliver',
    body: 'Export to DXF, DGN, GeoJSON, IFC or 3D Tiles, or push results straight into Esri and your CAD environment. API access is coming soon.',
  },
] as const;
---

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <span class="eyebrow reveal">How it works</span>
        <h2 class="reveal" style="margin-top:22px">From raw points to real answers in four steps</h2>
      </div>
      <p class="lede reveal">
        One pipeline replaces the chain of desktop tools, file conversions and manual drafting between a scan
        and a decision.
      </p>
    </div>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step reveal" style={`--reveal-delay:${i * 0.08}s`}>
            <div class="step__art">
              <IsoSlab variant={s.variant} />
            </div>
            <div class="step__head">
              <h3>{s.name}</h3>
              {i < steps.length - 1 && (
                <svg class="step__arrow" width="18" height="18" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" />
                </svg>
              )}
            </div>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 26px 32px;
    border-left: 1px solid var(--hairline);
    background: var(--card);
  }
  .step:first-child {
    border-left: 0;
  }
  .step__art {
    margin: 4px -6px 18px;
    padding: 18px 0;
    border-bottom: 1px dashed var(--hairline);
  }
  .step__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .step__arrow {
    color: var(--text-3);
  }
  .step p {
    color: var(--text-2);
    font-size: 15.5px;
  }
  @media (max-width: 1060px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .step:nth-child(3) {
      border-left: 0;
    }
    .step:nth-child(n + 3) {
      border-top: 1px solid var(--hairline);
    }
  }
  @media (max-width: 620px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .step {
      border-left: 0;
    }
    .step:nth-child(n + 2) {
      border-top: 1px solid var(--hairline);
    }
  }
</style>
