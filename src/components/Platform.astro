---
// Small line icons, drawn on a 32px grid.
const icons: Record<string, string> = {
  stream: '<path d="M4 24 16 6l12 18"/><path d="M9 17h14M6.5 21h19"/><circle cx="16" cy="6" r="1.6" fill="currentColor"/>',
  classify: '<circle cx="9" cy="10" r="3"/><circle cx="22" cy="9" r="2"/><circle cx="12" cy="22" r="2.4"/><circle cx="23" cy="21" r="3.4"/><path d="M4 28h24"/>',
  extract: '<path d="M4 22c5-2 7-10 12-10s7 8 12 6"/><circle cx="4" cy="22" r="1.6" fill="currentColor"/><circle cx="16" cy="12" r="1.6" fill="currentColor"/><circle cx="28" cy="18" r="1.6" fill="currentColor"/>',
  change: '<path d="M4 20h7l3-8 4 12 3-6h7"/><path d="M4 8h24" stroke-dasharray="2 3"/>',
  measure: '<path d="M5 25 25 5"/><path d="M5 25v-5M5 25h5M25 5v5M25 5h-5"/><path d="M11 19l2 2M15 15l2 2M19 11l2 2"/>',
  api: '<path d="m11 9-7 7 7 7M21 9l7 7-7 7M18 6l-4 20"/>',
};

const features = [
  { icon: 'stream', title: 'Streaming 3D viewer', body: 'Open billion-point scans instantly in any browser. Octree streaming means nobody waits on a download.' },
  { icon: 'classify', title: 'AI classification', body: 'Models trained on urban, corridor, utility and mine-site scans label every point, then learn from your corrections.' },
  { icon: 'extract', title: 'Feature extraction', body: 'Poles, kerbs, breaklines, footprints, canopy and conductors come out as clean, attributed vectors.' },
  { icon: 'change', title: 'Change detection', body: 'Compare capture epochs to surface what moved, grew, eroded or was built, with the volumes to prove it.' },
  { icon: 'measure', title: 'Measurement & analytics', body: 'Profiles, cross-sections, clearances, volumes and slopes, computed on the full-resolution data.' },
  { icon: 'api', title: 'API & SDK', soon: true, body: 'Everything in the interface will be in the API. Automate pipelines, embed views and pipe results into your stack.' },
];
---

<section class="section" id="platform">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <span class="eyebrow reveal">The platform</span>
        <h2 class="reveal" style="margin-top:22px">Spatial intelligence, end to end</h2>
      </div>
      <p class="lede reveal">
        Point clouds, imagery, terrain and vectors in one coordinate-aware workspace, with the analysis built in
        rather than bolted on.
      </p>
    </div>

    <div class="features">
      {
        features.map((f, i) => (
          <article class="feature reveal" style={`--reveal-delay:${(i % 3) * 0.06}s`}>
            <span class="feature__icon">
              <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} />
            </span>
            <h3 class="feature__title">
              {f.title}
              {f.soon && <span class="badge-soon">Coming soon</span>}
            </h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--hairline);
    border-left: 1px solid var(--hairline);
  }
  .feature {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 34px 30px 40px;
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    transition: background-color 0.3s ease;
  }
  .feature:hover {
    background: var(--card);
  }
  .feature__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 18px;
    border: 1px solid var(--hairline-strong);
    border-radius: 12px;
    color: var(--accent);
    background: linear-gradient(160deg, rgb(61 245 196 / 0.1), transparent 70%);
  }
  .feature__title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .feature p {
    color: var(--text-2);
    font-size: 16px;
  }
  @media (max-width: 960px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
